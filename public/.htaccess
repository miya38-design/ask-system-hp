# アスクシステム — セキュリティ関連のレスポンスヘッダー
#
# サーバーは LiteSpeed（health.php の sapi で確認）で、Apache 互換のため
# このファイルが読まれる。本番でヘッダーが出ていることは確認済み。
# すべて <IfModule> で囲ってあるので、モジュールが無い環境でも 500 にはならない。

<IfModule mod_headers.c>
  # 他サイトへの iframe 埋め込みを禁止（クリックジャッキング対策）
  Header always set X-Frame-Options "DENY"
  Header always set Content-Security-Policy "frame-ancestors 'none'"

  # 外部サイトへ送るリファラを、同一オリジン以外ではドメインまでに留める
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # 使っていないブラウザ機能を明示的に無効化
  # （カメラはアカデミーの受付端末で使うため、ここでは触らない）
  Header always set Permissions-Policy "geolocation=(), microphone=(), payment=(), usb=()"
</IfModule>

# www.asksystem.jp へのアクセスを asksystem.jp へ 301 で寄せる。
# Google が /privacy と /ict-support を www 側のURLでインデックスしてしまっているため、
# 正規URL（canonical と同じ非www）へ集約する。
#
# 【前提】現在 www の A レコードは別サーバー(118.27.122.112)を指しており、
# 証明書も一致しないため、このリダイレクトはまだ実行されない。
# お名前.com の DNS で www の A レコードを 118.27.122.214 に変更すると有効になる。
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.asksystem\.jp$ [NC]
  RewriteRule ^(.*)$ https://asksystem.jp/$1 [R=301,L]
</IfModule>

# .htaccess 自体をブラウザから読めないようにする（Apache 既定でも禁止されている）
<Files ".htaccess">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>
